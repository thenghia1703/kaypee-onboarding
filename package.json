{
  "name": "kaypee-onboarding-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "build": "node scripts/build-public.mjs",
    "dev:worker": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "wrangler": "^4.150.0"
  }
}
